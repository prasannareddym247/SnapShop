# ── Server ──
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── JWT Authentication ──
JWT_SECRET=change_this_to_a_random_secret_key
JWT_REFRESH_SECRET=change_this_to_a_different_random_key
JWT_EXPIRY=24h

# ── Database (SQL Server — omit to use JSON file mode) ──
DB_HOST=localhost
DB_PORT=1433
DB_NAME=FreshKart
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# ── Rate Limiting ──
GLOBAL_RATE_LIMIT=200

# ── Email (SMTP) ──
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@freshkart.com

# ── Queue ──
QUEUE_DRIVER=sync

# ── Backup ──
BACKUP_DIR=./backups

# ── Google Gemini AI (optional) ──
GEMINI_API_KEY=
